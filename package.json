{
  "name": "app-forge",
  "private": true,
  "type": "module",
  "description": "Fabbrica agentica delle app di Marketto e catalogo su GitHub Pages",
  "scripts": {
    "catalogo": "node tools/build-catalog.mjs",
    "schermate": "node tools/screenshots.mjs",
    "nuova-app": "node tools/nuova-app.mjs",
    "test": "node --test tests/*.test.mjs && node tools/build-catalog.mjs && node tools/privacy-check.mjs",
    "serve": "node tools/build-catalog.mjs && python3 -m http.server 8080 -d _site",
    "mcp": "node tools/mcp-server.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "playwright": "^1.49.0",
    "potrace": "^2.1.8",
    "sharp": "^0.35.5",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "ttf2woff2": "^8.0.1"
  },
  "license": "MIT",
  "bin": {
    "app-forge": "tools/cli.mjs"
  }
}
